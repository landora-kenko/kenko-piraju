# Copie para .env.local e preencha com os dados do app web do Firebase
# (Console Firebase > Configurações do projeto > Seus apps > App da Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# WhatsApp do restaurante (somente números, com 55 + DDD). Ex.: 5514999999999
VITE_WHATSAPP=
# Instagram do restaurante (sem @)
VITE_INSTAGRAM=
